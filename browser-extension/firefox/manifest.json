{
  "manifest_version": 2,
  "name": "MediaGrab — Send to desktop",
  "version": "0.1.0",
  "description": "Send links to MediaGrab and optionally detect media responses in the background.",
  "browser_specific_settings": {"gecko": {"id": "mediagrab@github.com", "strict_min_version": "115.0"}},
  "permissions": ["contextMenus", "nativeMessaging", "activeTab", "scripting", "webRequest", "storage"],
  "optional_permissions": ["*://*/*"],
  "background": {"scripts": ["background.js"]},
  "applications": {"gecko": {"id": "mediagrab@github.com"}},
  "browser_action": {"default_title": "Scan page media with MediaGrab", "default_popup": "popup.html"}
}
